{
  "name": "farshelf",
  "version": "0.1.0",
  "description": "Local-first, open-source way to use your cloud or self-hosted storage like a disk: streaming range reads, resumable uploads, optional end-to-end encryption and optional local AI.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "farshelf": "dist/server/server/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/FORMAT.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server/cli.ts start --no-open",
    "dev:web": "vite",
    "start": "node dist/server/server/cli.js start",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "webdav",
    "google-drive",
    "streaming",
    "encryption",
    "local-first",
    "ollama",
    "self-hosted"
  ],
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.64.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
