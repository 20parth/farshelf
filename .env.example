# All variables are optional. Copy to .env only if you use a process manager that reads it;
# Farshelf itself reads them from the environment.

# Where Farshelf keeps its database, cache and spool (default: OS app-data dir)
# FARSHELF_HOME=/path/to/farshelf-data

# Port and host for the daemon (default 127.0.0.1:7420). Binding beyond loopback exposes
# your files to the network: only do it behind TLS and a firewall.
# FARSHELF_PORT=7420
# FARSHELF_HOST=127.0.0.1

# Google Drive OAuth client (create your own "Desktop app" client in Google Cloud Console).
# These can also be entered in the UI when adding a Google Drive remote.
# FARSHELF_GDRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# FARSHELF_GDRIVE_CLIENT_SECRET=your-installed-app-client-secret

# Optional AI provider API key for OpenAI-compatible endpoints (prefer entering it in the UI,
# which stores it in the OS keychain when available). Never commit a real key.
# FARSHELF_AI_API_KEY=sk-placeholder
